# Copy this file to .env.local and fill in your EmailJS credentials.
# Get these values from https://dashboard.emailjs.com/admin

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# --- Admin panel (/admin) ---
# MongoDB Atlas connection string (content, messages, uploads and stats are stored here)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Admin login. The password is hashed into MongoDB on first login; change it later from the panel.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Random string, 32+ chars, signs the login cookie. Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# --- AI Job Assistant ---
# Google Gemini API key (recommended: free tier available at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional fallback provider:
# OPENAI_API_KEY=your_openai_api_key_here

# --- Email Composer Outgoing SMTP Sending ---
# Authenticated account used to deliver outreach emails with attached resume PDFs.
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
# Optional: custom From header if different from SMTP_USER
# SMTP_FROM="Your Name" <your_email@example.com>
